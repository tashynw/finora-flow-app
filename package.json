{
  "name": "finora-flow",
  "version": "0.1.0",
  "private": true,
  "description": "Finora Flow - Unified Invoice and Estimate Automation Platform",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @finora/web dev",
    "build": "pnpm --filter @finora/web build",
    "lint": "pnpm --filter @finora/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @finora/web test",
    "test:visual": "pnpm --filter @finora/web test:visual",
    "schema:export": "uv run --project apps/api python apps/api/scripts/export_openapi.py",
    "schema:check": "uv run --project apps/api python apps/api/scripts/export_openapi.py --check",
    "schema:generate": "pnpm schema:export && pnpm --filter @finora/shared-types generate",
    "storybook": "pnpm --filter @finora/web storybook",
    "stack:up": "docker compose --env-file deploy/containers/env/dev.env -f deploy/containers/docker-compose.dev.yml up -d",
    "stack:down": "docker compose --env-file deploy/containers/env/dev.env -f deploy/containers/docker-compose.dev.yml down",
    "stack:logs": "docker compose --env-file deploy/containers/env/dev.env -f deploy/containers/docker-compose.dev.yml logs -f",
    "stack:reset": "docker compose --env-file deploy/containers/env/dev.env -f deploy/containers/docker-compose.dev.yml down -v"
  }
}
