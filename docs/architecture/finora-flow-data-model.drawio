<mxfile host="app.diagrams.net" agent="finora-flow" version="22.1.0" type="device">
<diagram id="how-to-read-this" name="How to read this"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1058" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Finora Flow database model" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1B3A4B;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="900" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Source: apps/api/src/finora/infrastructure/db/models.py. Every table uses a uuid primary key." style="text;html=1;fontSize=13;align=left;fontColor=#3F3F3A;" vertex="1" parent="1"><mxGeometry x="40" y="72" width="1100" height="28" as="geometry"/></mxCell><mxCell id="c5" value="PK rows are blue. FK rows are amber. A UQ mark is a single-column unique constraint. Composite and partial uniques are listed as extra rows on the detail pages." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1080" height="56" as="geometry"/></mxCell><mxCell id="c6" value="Crow&#x27;s foot: the PK end is one (mandatory) or zero-or-one (the foreign key is nullable). The FK end is many, or one when that foreign key is unique." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="1080" height="56" as="geometry"/></mxCell><mxCell id="c7" value="Amounts are bigint minor units plus a separate ISO currency. There is no float money column. Timestamps are timestamptz, stored in UTC." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="248" width="1080" height="56" as="geometry"/></mxCell><mxCell id="c8" value="version is the optimistic-concurrency counter. archived_at hides a row without deleting it. Financial and audit rows are not hard-deleted." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="312" width="1080" height="56" as="geometry"/></mxCell><mxCell id="c9" value="Overview omits the many actor foreign keys to users (created_by, submitted_by, signed_off_by, and the rest). Those columns are still on the tables, and the edges are drawn on the area pages. The overview keeps the structural user links: roles, saved views, approval assignments, and delegate_to_id." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="376" width="1080" height="56" as="geometry"/></mxCell><mxCell id="c10" value="approval_requests, state_transitions, record_actions, reminder_schedules, signed_links, outbox_messages, and audit_entries point at a business record with record_type/subject_type plus an id. That pointer is not a database foreign key, so one approval and audit implementation serves estimates, invoices, and purchase orders. Those links are dashed." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="1080" height="56" as="geometry"/></mxCell><mxCell id="c11" value="inbound_messages.correlated_record_id is the same kind of pointer, used when a supplier reply is matched back to a vendor check-in." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="504" width="1080" height="56" as="geometry"/></mxCell><mxCell id="c12" value="Pages repeat lookup tables (users, vendors, documents, invoices) so each area&#x27;s foreign keys can be drawn without leaving the page." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="568" width="1080" height="56" as="geometry"/></mxCell><mxCell id="c13" value="Colour key" style="text;html=1;fontSize=16;fontStyle=1;align=left;fontColor=#1B3A4B;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="400" height="28" as="geometry"/></mxCell><mxCell id="c14" value="Identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A4B;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#1B3A4B;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="280" height="26" as="geometry"/></mxCell><mxCell id="c15" value="Configuration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F6E56;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#0F6E56;" vertex="1" parent="1"><mxGeometry x="40" y="714" width="280" height="26" as="geometry"/></mxCell><mxCell id="c16" value="Reference data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#185FA5;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#185FA5;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="280" height="26" as="geometry"/></mxCell><mxCell id="c17" value="Intake and documents" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3C3489;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#3C3489;" vertex="1" parent="1"><mxGeometry x="40" y="782" width="280" height="26" as="geometry"/></mxCell><mxCell id="c18" value="Spend and approvals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#854F0B;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#854F0B;" vertex="1" parent="1"><mxGeometry x="40" y="816" width="280" height="26" as="geometry"/></mxCell><mxCell id="c19" value="Payments and notifications" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#72243E;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#72243E;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="280" height="26" as="geometry"/></mxCell><mxCell id="c20" value="Credit cards" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C3A21;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#5C3A21;" vertex="1" parent="1"><mxGeometry x="40" y="884" width="280" height="26" as="geometry"/></mxCell><mxCell id="c21" value="Accruals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#27500A;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#27500A;" vertex="1" parent="1"><mxGeometry x="40" y="918" width="280" height="26" as="geometry"/></mxCell><mxCell id="c22" value="Audit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444441;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#444441;" vertex="1" parent="1"><mxGeometry x="40" y="952" width="280" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="overview" name="Overview"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5180" pageHeight="1372" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="All 38 tables. Columns shown are keys, foreign keys, and the polymorphic record pointers. Actor links to users are listed on the area pages." style="text;html=1;fontSize=14;align=left;fontColor=#3F3F3A;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1400" height="36" as="geometry"/></mxCell><mxCell id="c4" value="Identity" style="text;html=1;fontSize=14;fontStyle=1;align=left;fontColor=#1B3A4B;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="420" height="24" as="geometry"/></mxCell><mxCell id="c5" value="users" style="shape=table;startSize=32;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;fillColor=#1B3A4B;strokeColor=#1B3A4B;fontColor=#ffffff;fontSize=13;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="420" height="120" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=#E8EEF5;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;html=1;fontSize=11;" vertex="1" parent="c