        <mxCell id="ba-e-session" value="userId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#5C5C58;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#8A8680;strokeWidth=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="ba-session-r7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ba-e-account" value="userId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;fontColor=#5C5C58;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#8A8680;strokeWidth=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="ba-account-r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ba-note-user" value="&lt;b&gt;Better Auth sign-in&lt;/b&gt;&lt;br&gt;user, session, account, and verification come from the ARC Prisma schema. Sign-up is email and password. There is no OIDC subject.&lt;br&gt;&lt;br&gt;&lt;b&gt;role_enum&lt;/b&gt;&lt;br&gt;requester, approver, payment_coordinator, finance, administrator, operations, auditor. Better Auth stores one or more of these in user.role. The user_roles table is gone.&lt;br&gt;&lt;br&gt;&lt;b&gt;banned&lt;/b&gt;&lt;br&gt;is_active is gone. banned, banReason, and banExpires are the account flags.&lt;br&gt;&lt;br&gt;&lt;b&gt;departments&lt;/b&gt;&lt;br&gt;Its own table: name, cost_centre_number, is_active, created_at, updated_at. user.department_id points at it. approval_rules.department_id and approval_assignments.department_id are optional. A cost centre, estimate, purchase order, invoice, approval request, and accrual candidate point at it too.&lt;br&gt;&lt;br&gt;&lt;b&gt;approval level&lt;/b&gt;&lt;br&gt;enum: unit_head, manager, hod, coo. Same enum on approval_rules and approval_assignments.&lt;br&gt;&lt;br&gt;&lt;b&gt;approval_rules.record_type&lt;/b&gt;&lt;br&gt;enum: estimate, invoice, purchase_order.&lt;br&gt;&lt;br&gt;&lt;b&gt;currency&lt;/b&gt;&lt;br&gt;enum: JMD, USD.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dropped&lt;/b&gt;&lt;br&gt;user_roles, saved_views, business_calendar_days, retention_policies. approval_rules no longer has retired_by_id or supersedes_id. system_settings no longer has updated_by_id. Who changed a row is in audit_entries.&lt;br&gt;&lt;br&gt;&lt;b&gt;delegate_to_id&lt;/b&gt;&lt;br&gt;Who covers this person&#39;s approvals until out_of_office_until. It cannot point at the same user." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#FFF8E7;strokeColor=#C4A35A;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;spacingBottom=8;fontSize=11;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="1100" y="900" width="500" height="430" as="geometry" />
        </mxCell>
        <mxCell id="departments" value="departments" style="shape=table;startSize=32;container=1;collapsible=0;childLayout=tableLayout;fixedRows=1;rowLines=0;fontStyle=1;align=center;resizeLast=1;html=1;fillColor=#1B3A4B;strokeColor=#1B3A4B;fontColor=#ffffff;fontSize=13;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
