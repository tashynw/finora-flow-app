<mxfile host="app.diagrams.net" agent="finora-flow" pages="9">
  <diagram id="how-to-read-this" name="How to read this">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1058" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3" value="Finora Flow database model" style="text;html=1;fontSize=22;fontStyle=1;align=left;fontColor=#1B3A4B;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="Next model. user, session, account, and verification are the ARC Better Auth tables and use a text primary key. Sign-in is email and password. user.role stores the Finora role enum. departments is its own table. user_roles, saved_views, business_calendar_days, and retention_policies are not in this model. Every other table still uses a uuid primary key." style="text;html=1;fontSize=13;align=left;fontColor=#3F3F3A;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="PK rows are blue. FK rows are amber. A UQ mark is a single-column unique constraint. Composite and partial uniques are listed as extra rows on the detail pages." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1080" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="Crow&#39;s foot: the PK end is one (mandatory) or zero-or-one (the foreign key is nullable). The FK end is many, or one when that foreign key is unique." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="184" width="1080" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="Amounts are bigint minor units plus a separate ISO currency. There is no float money column. Timestamps are timestamptz, stored in UTC." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="248" width="1080" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="version is the optimistic-concurrency counter. archived_at hides a row without deleting it. Financial and audit rows are not hard-deleted." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="312" width="1080" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="Overview omits the many actor foreign keys to user (created_by, submitted_by, signed_off_by, and the rest). Those columns are still on the tables, and the edges are drawn on the area pages. The overview keeps the structural user links: departments, approval assignments, and delegate_to_id." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="376" width="1080" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="approval_requests, state_transitions, record_actions, and audit_entries point at a business record with record_type/subject_type plus an id. That pointer is not a database foreign key, so one approval and audit implementation serves estimates, invoices, and purchase orders. Those links are dashed." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1080" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="Pages repeat lookup tables (user, vendors, s3_document, invoices) so each area&#39;s foreign keys can be drawn without leaving the page." style="text;html=1;fontSize=13;align=left;spacing=4;fontColor=#1F2933;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="504" width="1080" height="56" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="Colour key" style="text;html=1;fontSize=16;fontStyle=1;align=left;fontColor=#1B3A4B;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="400" height="28" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="Identity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B3A4B;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#1B3A4B;" vertex="1" parent="1">
          <mxGeometry x="40" y="616" width="280" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="Configuration" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0F6E56;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#0F6E56;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="280" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="Reference data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#185FA5;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#185FA5;" vertex="1" parent="1">
          <mxGeometry x="40" y="684" width="280" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="Intake and documents" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3C3489;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#3C3489;" vertex="1" parent="1">
          <mxGeometry x="40" y="718" width="280" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="Spend and approvals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#854F0B;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#854F0B;" vertex="1" parent="1">
          <mxGeometry x="40" y="752" width="280" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="Payments and notifications" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#72243E;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#72243E;" vertex="1" parent="1">
          <mxGeometry x="40" y="786" width="280" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="Credit cards" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#5C3A21;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#5C3A21;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="280" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="Accruals" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#27500A;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#27500A;" vertex="1" parent="1">
          <mxGeometry x="40" y="854" width="280" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="Audit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#444441;fontColor=#ffffff;fontStyle=1;fontSize=12;strokeColor=#444441;" vertex="1" parent="1">
          <mxGeometry x="40" y="888" width="280" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
