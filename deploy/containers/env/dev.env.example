# Finora Flow - development environment template.
#
# Copy to `dev.env` and adjust. `dev.env` is git-ignored.
# These are local development values only. Production secrets must come from
# the configured secret store and never from a file in the repository.

# Host ports are deliberately offset from the service defaults. Developers
# commonly have another PostgreSQL or Redis already bound to 5432 or 6379, and a
# silent bind failure means the application connects to the wrong database.

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_USER=finora
POSTGRES_PASSWORD=finora_local_dev_only
POSTGRES_DB=finora
POSTGRES_PORT=55432

# --------------------------------------------------------------------- Redis
REDIS_PASSWORD=finora_local_dev_only
REDIS_PORT=56379

# ------------------------------------------------------ Object storage (S3)
S3_ACCESS_KEY=finora_local_access
S3_SECRET_KEY=finora_local_dev_only
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET_RAW=finora-raw-messages
S3_BUCKET_DOCUMENTS=finora-documents
S3_BUCKET_QUARANTINE=finora-quarantine
S3_BUCKET_EXPORTS=finora-exports
# Encryption key for MinIO's built-in key service, as `name:base64-32-bytes`.
# The API requests server-side encryption on every write, and MinIO refuses an
# encrypted write when it has no key service, so without this nothing can be
# stored at all. A real deployment uses KES or a cloud KMS and this value has no
# equivalent there.
S3_KMS_KEY=finora-dev-key:PGgQ0Xm5cE3XkxWXm3vHTF6q1sZ8mQeMcLPPFV0MTMs=

# ------------------------------------------------------------------- ClamAV
CLAMAV_PORT=3310

# ----------------------------------------------------- Mail test server
# Greenmail. Real deployments point at the controlled mailbox instead.
IMAP_PORT=3143
IMAPS_PORT=3993
SMTP_PORT=3025
SMTPS_PORT=3465
GREENMAIL_API_PORT=8085
